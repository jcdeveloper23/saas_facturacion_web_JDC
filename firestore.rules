rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function belongsToCompany(companyId) {
      return request.auth.token.companyId == companyId;
    }

    function hasRole(role) {
      return request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // ─── Canales (multimarca) ────────────────────────────────────────────
    // Conectate y Mi Buseta no son tenants: son canales. Cada uno tiene su
    // channel_admin, que administra SOLO las empresas de su canal.
    // Ver docs/PLAN_CANALES_MULTIMARCA.md.
    function isChannelAdmin() {
      return hasRole('channel_admin');
    }

    // Canal del llamador. '' cuando el token no trae el claim.
    function callerChannel() {
      return 'channelId' in request.auth.token ? request.auth.token.channelId : '';
    }

    // El canal del llamador existe y está activo. Suspender un canal corta a su
    // admin sin tocarle los claims. callerChannel() != '' va primero: un path
    // con segmento vacío haría fallar la regla.
    function callerChannelActive() {
      return callerChannel() != ''
        && exists(/databases/$(database)/documents/channels/$(callerChannel()))
        && get(/databases/$(database)/documents/channels/$(callerChannel())).data.status == 'active';
    }

    // Niega por defecto: sin canal en el token, sin canal en el documento, o
    // con el canal suspendido, no hay acceso. El super admin pasa siempre.
    // Se invoca con resource.data.get('channelId', '').
    function inCallerChannel(resourceChannelId) {
      return isSuperAdmin()
        || (isChannelAdmin()
            && resourceChannelId != ''
            && resourceChannelId == callerChannel()
            && callerChannelActive());
    }

    // Alta de un documento con canal (empresa o plan) por un channel_admin.
    function canCreateInCallerChannel() {
      return isChannelAdmin()
        && request.resource.data.get('channelId', '') == callerChannel()
        && callerChannelActive();
    }

    // El canal de un documento no se cambia desde el cliente: mover una
    // empresa de canal es una operación de plataforma, por Admin SDK.
    function channelUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['channelId']);
    }

    function canWrite() {
      return request.auth.token.role in ['admin', 'seller', 'cashier'];
    }

    function isAccountant() {
      return hasRole('accountant');
    }

    // Editar fichas y catálogo que ya existen: administrador o vendedor. El
    // cajero CREA clientes, proveedores y artículos (2026-10-08) pero no
    // cambia los que ya están: canWrite() lo incluye y por eso no sirve aquí.
    function canEditMasterData() {
      return request.auth.token.role in ['admin', 'seller'];
    }

    // El contador registra compras y necesita dar de alta al proveedor
    // (2026-10-07): crea fichas que son SOLO proveedor y las mantiene. A una
    // persona que ya es cliente solo le suma el papel de proveedor y sus datos
    // de proveedor; los de cliente no los toca.
    function accountantCreatesSupplier() {
      return isAccountant() && request.resource.data.get('roles', []) == ['supplier'];
    }

    function accountantUpdatesSupplier() {
      let antes = resource.data.get('roles', []);
      let despues = request.resource.data.get('roles', []);
      return isAccountant() && (
        (antes == ['supplier'] && despues == ['supplier'])
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['roles', 'supplierData', 'isActive', 'updatedAt', 'updatedBy'])
            && despues.hasAll(antes)
            && despues.hasAll(['supplier'])
            && despues.removeAll(antes).hasOnly(['supplier']))
      );
    }

    // True si el update SOLO toca los campos de cobro/pago (marcar factura o
    // compra pagada, o aplicar un anticipo) — nunca datos de línea/montos.
    // Deja pasar a un contador (isAccountant) sin darle permiso general de
    // edición sobre invoices/purchases, y permite marcar pagada una compra ya
    // 'received' (la regla general la bloquea después de recibida).
    // Un cambio «solo de pago» puede tocar `status`, pero solo para cobrar
    // (paid) o devolver a emitida (issued). Sin esto, poner status: 'void' a
    // secas pasaba como pago y un cajero anulaba facturas (visto 2026-09-22).
    function isPaymentStatusChange() {
      return request.resource.data.get('status', '') == resource.data.get('status', '')
          || request.resource.data.get('status', '') in ['paid', 'issued'];
    }

    function isPaymentOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'isPaid', 'paidAt', 'paymentBankAccountId', 'paymentEntryId', 'updatedAt', 'updatedBy']);
    }

    // ─── Compras (2026-10-02) ─────────────────────────────────────────────────
    // Registran compras el admin, el vendedor y el contador (el contador tiene
    // compras en su rol; el cajero no, aunque canWrite() lo incluya).
    function canWritePurchases() {
      return request.auth.token.role in ['admin', 'seller'] || isAccountant();
    }

    // Lo que escriben solo las functions (stock y asientos). Si el cliente
    // pudiera poner stockProcessed o accountingEntryId, se saltaría el kardex
    // o el asiento.
    function purchaseServerKeys() {
      return ['stockProcessed', 'stockProcessedAt', 'stockError',
              'accountingEntryId', 'accountingError', 'reversalEntryId', 'reversalError'];
    }

    // La web crea las compras con stockProcessed: false; eso se acepta. Lo que
    // no, es nacer con el stock ya procesado o con datos del asiento.
    function purchaseCreateOk() {
      return request.resource.data.get('stockProcessed', false) == false
          && !request.resource.data.keys().hasAny(['stockProcessedAt', 'stockError',
               'accountingEntryId', 'accountingError', 'reversalEntryId'])
          && request.resource.data.get('status', 'draft') in ['draft', 'sent', 'received'];
    }

    // Editar el contenido: solo mientras es borrador o enviada. Recibida,
    // pagada o cancelada ya no (las líneas ya movieron stock y asiento, o la
    // compra se cerró). Antes la regla solo protegía 'received'.
    function purchaseContentUpdateOk() {
      return resource.data.get('status', 'draft') in ['draft', 'sent']
          && request.resource.data.get('status', 'draft') in ['draft', 'sent', 'received', 'cancelled']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(purchaseServerKeys());
    }

    // Pagar: solo una compra recibida (antes de recibirla no hay CxP que
    // saldar) y el estado solo puede quedar igual o pasar a 'paid'. Sin esto,
    // un «pago» podía poner status: 'received' y disparar el stock.
    function purchasePaymentUpdateOk() {
      return isPaymentOnlyUpdate()
          && resource.data.get('status', '') in ['received', 'paid']
          && request.resource.data.get('status', '') in [resource.data.get('status', ''), 'paid'];
    }

    // La compra recibida queda ligada a su retención (2026-10-06): solo
    // `retentionId`, una vez, y a una retención que existe. Sin esto, la web
    // mandaba a crear la retención pero nunca guardaba el vínculo.
    function purchaseRetentionLinkOk(companyId) {
      return resource.data.get('status', '') in ['received', 'paid']
          && !('retentionId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['retentionId', 'updatedAt', 'updatedBy'])
          && request.resource.data.retentionId is string
          && exists(/databases/$(database)/documents/companies/$(companyId)/retentions/$(request.resource.data.retentionId));
    }

    // Corregir el sustento tributario (tabla 5 del ATS) de una compra ya
    // recibida o pagada (2026-10-08): solo el admin y el contador, solo
    // `sriSustentoCode` (más updatedAt/updatedBy), con un código de la tabla 5
    // vigente, y solo si la compra aún no tiene retención: la retención lleva
    // ese código en su XML (<codSustento>) y ya no se puede cambiar.
    // Ojo: el asiento de la compra NO se rehace (ver docs); si el código pasa
    // de con crédito (01, 03, 06) a sin crédito o al revés, el IVA del asiento
    // queda en la cuenta vieja y se ajusta con un asiento manual.
    function purchaseSustentoFixOk() {
      return (isAdmin() || isAccountant())
          && resource.data.get('status', '') in ['received', 'paid']
          && resource.data.get('retentionId', null) in [null, '']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['sriSustentoCode', 'updatedAt', 'updatedBy'])
          && request.resource.data.get('sriSustentoCode', '') in
               ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10',
                '11', '12', '13', '14', '15'];
    }

    // Retenciones: lo que solo escribe el servidor (2026-10-06). Igual que con
    // las facturas: nadie las crea ni las marca autorizadas desde el cliente.
    // Reintentar (borrar sriStatus/sriError) sí se puede.
    function retentionServerKeys() {
      return ['authorizationNumber', 'authorizedAt', 'accessKey', 'codigoNumerico',
              'accountingEntryId', 'reversalEntryId', 'reversalError'];
    }

    function retentionSriClientCreate() {
      return !request.resource.data.keys().hasAny(retentionServerKeys().concat(['sriStatus']));
    }

    function retentionSriClientUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(retentionServerKeys())
          && (!changed.hasAny(['sriStatus']) || request.resource.data.get('sriStatus', null) == null);
    }

    // Puntos de emisión desde los que el usuario puede emitir
    // (company-users/{uid}.emissionPoints, «001-002»: establecimiento-punto).
    // Sin lista, o vacía, son todos: decisión del 2026-09-22 para no dejar sin
    // facturar a los usuarios que ya existían. El admin y el super admin, siempre
    // todos. Un usuario sin perfil de empresa (legado) cuenta como «todos».
    function canUseEmissionPoint(companyId) {
      let profile = /databases/$(database)/documents/companies/$(companyId)/company-users/$(request.auth.uid);
      let allowed = exists(profile) ? get(profile).data.get('emissionPoints', []) : [];
      return isAdmin() || isSuperAdmin() || allowed.size() == 0 || docEmissionPoint() in allowed;
    }

    // Punto de emisión del comprobante que se escribe, como «001-002».
    function docEmissionPoint() {
      return request.resource.data.get('seriesEstablishment', '') + '-'
           + request.resource.data.get('seriesEmissionPoint', '');
    }

    // Collections that already have their own dedicated `match` block below
    // with admin/accountant-only restrictions (chart_of_accounts,
    // accounting_periods, journal_entries, etc.). Firestore evaluates every
    // matching `match` block with OR semantics — it does NOT prefer the
    // "more specific" one — so the generic catch-all rule at the bottom of
    // this file MUST exclude these names explicitly. Otherwise its broader
    // canWrite() (which includes seller/cashier) silently re-grants access
    // that the specific rule above just denied.

    // Los datos del certificado de firma los escribe solo `uploadCertificate`,
    // que valida el .p12 contra su contraseña y el RUC de la empresa. El admin
    // edita su configuración SRI —RUC, ambiente, establecimiento— pero no estos
    // campos, y `certificatePassword` ya no se guarda aquí: vive en Secret
    // Manager desde el 2026-09-23.
    function certificateUnchanged() {
      let antes = resource.data.get('sri', {});
      let despues = request.resource.data.get('sri', {});
      return !('certificatePassword' in despues.keys())
        && despues.get('certificatePath', '') == antes.get('certificatePath', '')
        && despues.get('certificateThumbprint', '') == antes.get('certificateThumbprint', '')
        && despues.get('certificateSubject', '') == antes.get('certificateSubject', '')
        && despues.get('certificateExpiry', '') == antes.get('certificateExpiry', '');
    }

    // Colecciones de la empresa que tienen su propio `match`. La regla por
    // defecto NO debe aplicarles, ni para leer ni para escribir: las reglas se
    // suman, y esa regla —que deja escribir a admin, seller y cashier— anulaba
    // sus restricciones. Visto el 2026-09-22 en emulador: un cajero editaba
    // facturas anuladas y las anulaba, un vendedor cambiaba retenciones ya
    // autorizadas por el SRI y el kardex, un cajero reescribía la configuración
    // SRI. Toda colección que se agregue con `match` propio va en esta lista.
    function hasOwnRules(collection) {
      return collection in [
        'company-users', 'configuration', 'counters', 'customers', 'debitNotes',
        'electronic-documents', 'establishments', 'families', 'imported-xml', 'invoices',
        'paymentMethods', 'receivedRetentions', 'settings',
        'manufacturers', 'orders', 'personas', 'products', 'purchases', 'quotes',
        'retentions', 'stock-movements', 'stock-transfers', 'suppliers',
        'tm-members', 'tm-positions', 'tm-projects', 'tm-requests', 'tm-specialties',
        'tm-tasks', 'tm-timesheets', 'usage', 'warehouses'
      ];
    }

    // Forma de pago: el código tiene que ser de la Tabla 24 del SRI (uno
    // inventado haría rechazar el comprobante) y el nombre, corto y no vacío.
    function paymentMethodShapeOk() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.sriCode in ['01', '15', '16', '17', '18', '19', '20', '21']
          && d.get('bankAccountId', '') is string
          && d.get('isActive', true) is bool;
    }

    function isAccountingGovernedCollection(collection) {
      return collection in [
        'chart_of_accounts', 'accounting_periods', 'cost_centers',
        'journal_entries', 'bank_accounts', 'bank_statements',
        'bank_reconciled_entries',
        'budgets', 'fixed_assets', 'advances',
        'petty_cash_funds', 'petty_cash_movements', 'audit_log', 'matches'
      ];
    }

    // ─── Conciliación bancaria (2026-10-07) ──────────────────────────────
    // Contrato compartido con Conecta. Un extracto conciliado
    // (status 'reconciled') queda cerrado: ni él, ni sus movimientos, ni sus
    // emparejamientos se tocan hasta que el admin lo reabra.
    function bankStatementPath(companyId, statementId) {
      return /databases/$(database)/documents/companies/$(companyId)/bank_statements/$(statementId);
    }

    // El extracto existe y no está conciliado. Si todavía no existe, vale el
    // estado con que queda al final del batch: la web crea el extracto y sus
    // movimientos en un mismo writeBatch, y get() ve el estado anterior.
    function bankStatementOpen(companyId, statementId) {
      let p = bankStatementPath(companyId, statementId);
      return exists(p)
        ? get(p).data.get('status', 'draft') != 'reconciled'
        : (existsAfter(p) && getAfter(p).data.get('status', 'draft') != 'reconciled');
    }

    // Para bank_reconciled_entries: un extracto que ya no existe no bloquea
    // (si no, una marca huérfana impediría anular el asiento para siempre).
    function bankStatementGoneOrOpen(companyId, statementId) {
      let p = bankStatementPath(companyId, statementId);
      return !exists(p) || get(p).data.get('status', 'draft') != 'reconciled';
    }

    function bankStatementShapeOk() {
      let d = request.resource.data;
      return d.bankAccountId is string && d.bankAccountId.size() > 0
          && d.get('status', 'draft') in ['draft', 'in_progress', 'reconciled'];
    }

    // Reabrir: conciliado → en curso, solo el admin, y sin tocar nada más que
    // el estado y quién/cuándo concilió.
    function bankStatementReopenOk() {
      return isAdmin()
          && request.resource.data.get('status', '') == 'in_progress'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reconciledAt', 'reconciledBy', 'updatedAt', 'updatedBy']);
    }

    // ─── Asientos contabilizados (2026-10-07) ────────────────────────────
    // Un asiento 'posted' ya no cambia sus líneas, montos ni fecha: solo se
    // anula, con los mismos campos que escriben la web (cancelEntry) y
    // Conecta (journal_service.dart cancel()).
    function postedEntryCancelOk() {
      return request.resource.data.get('status', '') == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason', 'updatedAt', 'updatedBy']);
    }

    // No se anula un asiento que tiene líneas conciliadas con el banco:
    // primero se deshace la conciliación. existsAfter: si el mismo batch
    // quita la marca (y eso lo permite su propia regla), sí se anula.
    function entryNotBankReconciled(companyId, entryId) {
      return !existsAfter(/databases/$(database)/documents/companies/$(companyId)/bank_reconciled_entries/$(entryId));
    }

    // ─── Ejercicio cerrado: no se anula (2026-10-08) ────────────────────
    // Decisión del usuario: un documento cuyo ejercicio contable ya está
    // cerrado (accounting_periods/{id}.status == 'closed') no se anula; se
    // corrige con una nota de crédito o un asiento en el ejercicio abierto.
    // Anularlo crearía una reversa (generate-reversal-entry.ts) dentro de un
    // ejercicio cerrado, y el cierre y la apertura del año siguiente ya no
    // cuadrarían. El servidor también lo frena (por si llega por otra vía).
    //
    // Cómo se sabe el ejercicio del documento, en este orden (basta uno):
    //   1. Su asiento (accountingEntryId → journal_entries.periodId): es el
    //      mismo ejercicio que usaría la reversa. Exacto.
    //   2. Su año → accounting_periods/y{AAAA}, el id que pone
    //      openAccountingPeriod. El año sale de `fiscalYear` (facturas, NC,
    //      ND, retenciones) o, en compras, de supplierInvoiceDate / date en
    //      hora de Ecuador (UTC-5, sin horario de verano), igual que
    //      ecuadorYear() del servidor.
    // Si no existe ese ejercicio (o fue creado por la web con otro id y el
    // documento no tiene asiento), no se bloquea: sin ejercicio no hay nada
    // cerrado que proteger, y bloquear por ausencia dejaría sin anular a las
    // empresas que no llevan contabilidad.
    function periodClosed(companyId, periodId) {
      return periodId is string && periodId != ''
        && periodStatusClosed(companyId, periodId);
    }

    function periodStatusClosed(companyId, periodId) {
      let p = /databases/$(database)/documents/companies/$(companyId)/accounting_periods/$(periodId);
      return exists(p) && get(p).data.get('status', '') == 'closed';
    }

    function entryPeriodClosed(companyId, entryId) {
      return entryId is string && entryId != ''
        && entryPeriodStatusClosed(companyId, entryId);
    }

    function entryPeriodStatusClosed(companyId, entryId) {
      let e = /databases/$(database)/documents/companies/$(companyId)/journal_entries/$(entryId);
      return exists(e) && periodClosed(companyId, get(e).data.get('periodId', ''));
    }

    // Año en hora de Ecuador de un Timestamp.
    function ecuadorYear(t) {
      return (t - duration.value(5, 'h')).year();
    }

    // Id del ejercicio por el año del documento ('y2026'), o '' si no se sabe.
    function docPeriodIdByYear(d) {
      return d.get('fiscalYear', null) is string && d.get('fiscalYear', '').matches('^[0-9]{4}$')
          ? 'y' + d.get('fiscalYear', '')
        : d.get('fiscalYear', null) is int
          ? 'y' + string(d.get('fiscalYear', 0))
        : d.get('supplierInvoiceDate', null) is timestamp
          ? 'y' + string(ecuadorYear(d.get('supplierInvoiceDate', null)))
        : d.get('date', null) is timestamp
          ? 'y' + string(ecuadorYear(d.get('date', null)))
        : '';
    }

    function docPeriodClosed(companyId) {
      return entryPeriodClosed(companyId, resource.data.get('accountingEntryId', ''))
          || periodClosed(companyId, docPeriodIdByYear(resource.data));
    }

    // ¿Esta escritura anula el documento? isVoid pasa a true, o el estado
    // pasa a void / cancelled (facturas y NC: 'void'; compras: 'cancelled').
    function isVoidingWrite() {
      return (request.resource.data.get('isVoid', false) == true
              && resource.data.get('isVoid', false) != true)
          || (request.resource.data.get('status', '') in ['void', 'cancelled']
              && !(resource.data.get('status', '') in ['void', 'cancelled']));
    }

    // Se evalúa solo si la escritura anula: cobrar o editar no paga lecturas.
    function notVoidingInClosedPeriod(companyId) {
      return !isVoidingWrite() || !docPeriodClosed(companyId);
    }

    // Returns true if the caller belongs to the company AND has at least
    // one of the roles allowed to read fiscal documents (retentions, debitNotes).
    function canReadFiscalDoc(companyId) {
      return isAuthenticated()
        && (isSuperAdmin() || belongsToCompany(companyId))
        && request.auth.token.role in ['admin', 'accountant', 'seller', 'super_admin'];
    }

    // Returns true if the caller can create/issue fiscal documents.
    // Minimum role: seller (same as invoices).
    function canCreateFiscalDoc(companyId) {
      return isAuthenticated()
        && belongsToCompany(companyId)
        && request.auth.token.role in ['admin', 'accountant', 'seller'];
    }

    // Returns true for the restricted set of UI-only fields that a Cloud
    // Function trigger writes after SRI processing.  The rule allows a client
    // update ONLY when every changed key is in this allow-list.
    // Note: Cloud Functions use Admin SDK and bypass these rules entirely.
    function onlyUiFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pdfUrl', 'xmlUrl', 'sriError', 'updatedAt', 'updatedBy', 'notes']);
    }

    // A document whose sriStatus is 'authorized' is legally immutable from
    // the client: only the UI-level fields above may change.
    function sriAuthorizedGuard() {
      return resource.data.get('sriStatus', '') != 'authorized' || onlyUiFields();
    }

    // ─── Lo que en una factura solo escribe el servidor ─────────────────
    // `sriStatus: 'authorized'` y los datos de la autorización los ponen
    // onInvoiceEmit / checkSriStatus tras hablar con el SRI, y los de
    // importación la callable importInvoices (Admin SDK: no pasan por aquí).
    // Hasta el 2026-09-30 cualquier rol con canWrite() podía crear —o editar
    // para marcar— una factura «autorizada por el SRI» sin haber pasado por él.
    function invoiceServerOnlyKeys() {
      return ['authorizationNumber', 'authorizedAt', 'authorizationVerified',
              'verifiedWithSri', 'imported', 'importedXmlId', 'importedXmlPath',
              'reversalError',
              // Acumulado de retenciones recibidas (2026-10-08): solo cambia
              // con su propia regla (invoiceReceivedRetentionUpdateOk), en la
              // misma transacción que la retención.
              'receivedRetentions'];
    }

    // Desde el cliente una factura nace sin estado del SRI (la toma
    // onInvoiceEmit) o con 'not_required' (empresa sin SRI). Ausente y null
    // valen lo mismo: la web convierte undefined en null (cleanDoc).
    function invoiceSriStatusClientCreate() {
      return request.resource.data.get('sriStatus', null) in [null, 'not_required']
        && !request.resource.data.keys().hasAny(invoiceServerOnlyKeys());
    }

    // Al editar: los campos del servidor no se tocan, y `sriStatus` queda igual
    // o se borra / pasa a 'not_required' —es el «reintentar» de la web y de
    // Conecta—, pero nunca si ya estaba autorizada.
    function invoiceSriStatusClientUpdate() {
      let antes = resource.data.get('sriStatus', null);
      let despues = request.resource.data.get('sriStatus', null);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(invoiceServerOnlyKeys())
        && (despues == antes
            || (antes != 'authorized' && despues in [null, 'not_required']));
    }

    // Una factura autorizada por el SRI no se edita desde el cliente: su
    // contenido (cliente, líneas, totales, fechas) es el que el SRI autorizó.
    // Hasta el 2026-09-30 un vendedor o un cajero podía cambiarle el total
    // mientras no tocara `sriStatus` (retenciones y notas de débito ya tenían
    // sriAuthorizedGuard). Solo pasan, y revisados uno por uno contra la web,
    // el POS, los anticipos y Conectate:
    //   · los campos de interfaz de onlyUiFields();
    //   · cobrarla (markPaid, anticipos: los de isPaymentOnlyUpdate);
    //   · anularla o devolverla a emitida (markVoid, markIssued, «Anular» de
    //     Conectate), que las reglas de más abajo reservan al admin.
    // El estado solo puede quedar en issued, paid o void: nunca volver a borrador.
    function invoiceAuthorizedGuard() {
      return resource.data.get('sriStatus', '') != 'authorized'
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pdfUrl', 'xmlUrl', 'sriError', 'notes', 'updatedAt', 'updatedBy',
              'status', 'isPaid', 'paidAt', 'paymentBankAccountId', 'paymentEntryId',
              'isVoid', 'voidedAt'])
            && request.resource.data.get('status', '') in ['issued', 'paid', 'void']);
    }

    // Once a document is 'issued' or 'void' the client cannot revert it to
    // 'draft'.  The status field must either stay the same or move forward.
    function statusNotRolledBack() {
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;
      // draft → issued/void  : ok
      // issued → void         : ok (annulment)
      // anything → draft      : NOT ok
      return newStatus != 'draft' || oldStatus == 'draft';
    }

    // ─── Retenciones recibidas de clientes (2026-10-08) ─────────────────
    // companies/{cid}/receivedRetentions/{id}: el comprobante de retención
    // que un cliente (agente de retención) le entrega a la empresa al pagarle
    // una factura. No lo emite la empresa ni va al SRI: se registra. Su asiento
    // (Debe 1.1.05.006 / 1.1.05.005, Haber CxC) lo hace el servidor.
    //
    // La factura lleva el acumulado en `receivedRetentions`
    // ({ivaCents, rentaCents, rentaBaseCents, count, lastId}, enteros en
    // centavos para que la suma sea exacta). Alta y anulación van en UNA
    // transacción que escribe la retención y el acumulado; cada lado comprueba
    // al otro con get/getAfter, así que:
    //   · la suma de lo retenido no pasa del IVA de la factura, ni la base de
    //     renta de su base imponible (con lo ya registrado);
    //   · el acumulado no se toca sin una retención que lo respalde.
    //
    // Registran admin, contador y vendedor (los que leen documentos fiscales,
    // canReadFiscalDoc): el comprobante lo recibe quien gestiona el cobro, que
    // muchas veces es el vendedor. El cajero no: no lee retenciones. Anulan y
    // editan las notas solo admin y contador, y no en un ejercicio cerrado.
    // Solo a una factura autorizada, viva y SIN COBRAR: el cobro entra al banco
    // por el total menos lo retenido (payment-entry.ts), así que la retención va
    // antes que el cobro.
    function canRegisterReceivedRetention(companyId) {
      return isAuthenticated() && belongsToCompany(companyId)
        && request.auth.token.role in ['admin', 'accountant', 'seller'];
    }

    function receivedRetentionServerKeys() {
      return ['accountingEntryId', 'accountingError', 'reversalEntryId', 'reversalError'];
    }

    function invoiceDocPath(companyId, invoiceId) {
      return /databases/$(database)/documents/companies/$(companyId)/invoices/$(invoiceId);
    }

    // Un campo del acumulado de una factura (0 si no tiene).
    function rrAcc(invoiceData, k) {
      return invoiceData.get('receivedRetentions', {}).get(k, 0);
    }

    function receivedRetentionShapeOk() {
      let d = request.resource.data;
      return d.invoiceId is string && d.invoiceId.size() > 0
        && d.status == 'registered' && d.get('isVoid', false) == false
        && d.ivaCents is int && d.rentaCents is int && d.rentaBaseCents is int
        && d.ivaCents >= 0 && d.rentaCents >= 0 && d.rentaBaseCents >= 0
        && d.ivaCents + d.rentaCents > 0
        && d.rentaCents <= d.rentaBaseCents
        && d.number is string && d.number.matches('^[0-9]{3}-[0-9]{3}-[0-9]{9}$')
        && d.fiscalYear is string && d.fiscalYear.matches('^[0-9]{4}$')
        && d.date is timestamp && string(ecuadorYear(d.date)) == d.fiscalYear
        && d.get('lines', []) is list
        && !d.keys().hasAny(receivedRetentionServerKeys());
    }

    // La factura: autorizada, emitida, sin cobrar, viva y no es NC; y el
    // acumulado sube exactamente lo de esta retención, sin pasarse.
    function receivedRetentionInvoiceCreateOk(companyId, rid, invoiceId) {
      let p = invoiceDocPath(companyId, invoiceId);
      let antes = get(p).data;
      let despues = getAfter(p).data;
      let d = request.resource.data;
      return antes.get('isCreditNote', false) != true
        && antes.get('documentType', '') != 'creditNote'
        && antes.get('status', '') == 'issued'
        && antes.get('isPaid', false) != true
        && antes.get('isVoid', false) != true
        && antes.get('sriStatus', '') == 'authorized'
        && despues.get('receivedRetentions', {}).get('lastId', '') == rid
        && rrAcc(despues, 'ivaCents') == rrAcc(antes, 'ivaCents') + d.ivaCents
        && rrAcc(despues, 'rentaCents') == rrAcc(antes, 'rentaCents') + d.rentaCents
        && rrAcc(despues, 'rentaBaseCents') == rrAcc(antes, 'rentaBaseCents') + d.rentaBaseCents
        && rrAcc(despues, 'ivaCents') <= antes.get('vatAmount', 0) * 100 + 0.5
        && rrAcc(despues, 'rentaBaseCents') <= antes.get('netAmount', 0) * 100 + 0.5;
    }

    // Anular: solo admin y contador, solo esos campos, y el acumulado de la
    // factura baja exactamente lo de esta retención.
    function receivedRetentionVoidOk(companyId, rid) {
      let d = request.resource.data;
      let p = invoiceDocPath(companyId, resource.data.invoiceId);
      let antes = get(p).data;
      let despues = getAfter(p).data;
      return (isAdmin() || isAccountant())
        && resource.data.status == 'registered'
        && d.status == 'void' && d.isVoid == true
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'isVoid', 'voidedAt', 'voidedBy', 'voidReason', 'updatedAt', 'updatedBy'])
        && despues.get('receivedRetentions', {}).get('lastId', '') == rid
        && rrAcc(despues, 'ivaCents') == rrAcc(antes, 'ivaCents') - resource.data.ivaCents
        && rrAcc(despues, 'rentaCents') == rrAcc(antes, 'rentaCents') - resource.data.rentaCents
        && rrAcc(despues, 'rentaBaseCents') == rrAcc(antes, 'rentaBaseCents') - resource.data.rentaBaseCents;
    }

    // Del lado de la factura: solo el acumulado (y quién/cuándo), y respaldado
    // por la retención `lastId` que se crea o se anula en la misma escritura.
    function invoiceReceivedRetentionUpdateOk(companyId, invoiceId) {
      let despues = request.resource.data.get('receivedRetentions', {});
      return isAuthenticated() && belongsToCompany(companyId)
        && request.auth.token.role in ['admin', 'accountant', 'seller']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['receivedRetentions', 'updatedAt', 'updatedBy'])
        && despues.get('lastId', '') is string && despues.get('lastId', '') != ''
        && invoiceReceivedRetentionDeltaOk(companyId, invoiceId, despues.get('lastId', ''),
             resource.data.get('receivedRetentions', {}), despues);
    }

    function invoiceReceivedRetentionDeltaOk(companyId, invoiceId, rid, antes, despues) {
      let rp = /databases/$(database)/documents/companies/$(companyId)/receivedRetentions/$(rid);
      let r = getAfter(rp).data;
      return r.invoiceId == invoiceId
        && ((!exists(rp) && r.status == 'registered'
             && despues.get('ivaCents', 0) == antes.get('ivaCents', 0) + r.ivaCents
             && despues.get('rentaCents', 0) == antes.get('rentaCents', 0) + r.rentaCents
             && despues.get('rentaBaseCents', 0) == antes.get('rentaBaseCents', 0) + r.rentaBaseCents
             && despues.get('count', 0) == antes.get('count', 0) + 1)
            || (exists(rp) && get(rp).data.status == 'registered' && r.status == 'void'
             && despues.get('ivaCents', 0) == antes.get('ivaCents', 0) - r.ivaCents
             && despues.get('rentaCents', 0) == antes.get('rentaCents', 0) - r.rentaCents
             && despues.get('rentaBaseCents', 0) == antes.get('rentaBaseCents', 0) - r.rentaBaseCents
             && despues.get('count', 0) == antes.get('count', 0) - 1));
    }

    // Una factura con retenciones recibidas vivas no se anula: primero se
    // anulan las retenciones (si no, la CxC quedaría en negativo).
    function invoiceWithoutReceivedRetentions() {
      return rrAcc(resource.data, 'ivaCents') + rrAcc(resource.data, 'rentaCents') == 0;
    }

    // ─── Companies (tenants) ──────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isAuthenticated()
                  && (isSuperAdmin()
                      || belongsToCompany(companyId)
                      || inCallerChannel(resource.data.get('channelId', '')));

      // El channel_admin crea solo dentro de su canal, y el canal viaja en el
      // documento: si no coincide con su claim, no se escribe.
      allow create: if isAuthenticated()
                    && (isSuperAdmin()
                        || canCreateInCallerChannel());

      allow update, delete: if isAuthenticated()
                    && (isSuperAdmin()
                        || (inCallerChannel(resource.data.get('channelId', ''))
                            && channelUnchanged()));
      // Company admin can update marketplace config, SRI settings, and brand customization
      allow update: if isAuthenticated()
                    && belongsToCompany(companyId)
                    && isAdmin()
                    && certificateUnchanged()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'marketplace', 'sri', 'logoUrl', 'brandColor', 'brandAccentColor',
                         'sidebarTheme', 'buttonStyle', 'cardRadius', 'appTitleSuffix',
                         'showLogoOnPdf', 'pdfFooterMessage', 'name', 'updatedAt'
                       ]);

      // ─── All tenant sub-collections ─────────────────────────────────
      match /personas/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        // Crear: admin, vendedor y cajero (clientes y proveedores; el cajero
        // da de alta al cliente al cobrar y al proveedor desde «Clientes y
        // proveedores», 2026-10-08) y el contador (solo proveedores).
        allow create: if isAuthenticated() && belongsToCompany(companyId)
                      && (canWrite() || accountantCreatesSupplier());
        // Editar: admin y vendedor, y el contador sus proveedores. El cajero
        // no edita fichas que ya existen (2026-10-08): ninguna pantalla suya
        // las actualiza; antes canWrite() se lo dejaba con el SDK.
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                      && (canEditMasterData() || accountantUpdatesSupplier());
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /customers/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        // Colección legada (la sucede personas): mismas reglas, el cajero
        // crea pero no edita (2026-10-08).
        allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
        allow update: if isAuthenticated() && belongsToCompany(companyId) && canEditMasterData();
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /suppliers/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        // Colección legada (la sucede personas): mismas reglas, el cajero
        // crea pero no edita (2026-10-08).
        allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
        allow update: if isAuthenticated() && belongsToCompany(companyId) && canEditMasterData();
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /products/{productId} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        // Crear y editar el catálogo: administrador o vendedor, como dicen sus
        // permisos (products.create / products.edit). Antes era canWrite(), que
        // incluye al cajero: la pantalla no le mostraba el botón, pero con el
        // SDK podía crear y cambiar artículos (hallazgo del 2026-10-01). El POS
        // no escribe aquí: las existencias las mueve el servidor.
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                              && (isAdmin() || hasRole('seller'));
        // El contador CREA el artículo que necesita para registrar su compra
        // (2026-10-07) y el cajero el que necesita para cobrar o facturar
        // (2026-10-08), los dos sin existencias de entrada (las suma una
        // compra o un ajuste). Editar y borrar el catálogo sigue siendo de otros.
        allow create: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAccountant() || hasRole('cashier'))
                      && request.resource.data.get('stockQty', 0) == 0;
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();

        // Product subcollections
        match /stocks/{warehouseCode} {
          allow read: if isAuthenticated() && belongsToCompany(companyId);
          // Only admins can manually adjust stock; Cloud Functions also write here
          allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        }
        match /suppliers/{supplierId} {
          allow read: if isAuthenticated() && belongsToCompany(companyId);
          // El cajero puede crearlo con su artículo, no cambiarlo (2026-10-08).
          allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
          allow update: if isAuthenticated() && belongsToCompany(companyId) && canEditMasterData();
          allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        }
        match /variants/{variantId} {
          allow read: if isAuthenticated() && belongsToCompany(companyId);
          // El cajero puede crearlo con su artículo, no cambiarlo (2026-10-08).
          allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
          allow update: if isAuthenticated() && belongsToCompany(companyId) && canEditMasterData();
          allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        }
      }

      match /families/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /manufacturers/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /stock-transfers/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
        // Only admin can receive or cancel a transfer
        allow update: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        allow delete: if false; // audit trail
      }

      match /invoices/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite()
                      && canUseEmissionPoint(companyId)
                      && invoiceSriStatusClientCreate();
        // Cannot edit a cancelled invoice; only admin can void.
        // Editar exige el punto de emisión del comprobante; cobrarla (solo pago)
        // no: cobrar no es emitir, y quien cobra en caja no siempre es de ese
        // punto.
        // Payment-only updates (marcar pagada / aplicar anticipo) además
        // aceptan al contador, sin darle edición general de la factura.
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                       && resource.data.status != 'cancelled'
                       && invoiceSriStatusClientUpdate()
                       && invoiceAuthorizedGuard()
                       // Ejercicio cerrado: no se anula (2026-10-08).
                       && notVoidingInClosedPeriod(companyId)
                       // Con retenciones recibidas vivas, no se anula (2026-10-08).
                       && (!isVoidingWrite() || invoiceWithoutReceivedRetentions())
                       // La app anula con 'void'. Sin esto un vendedor o cajero
                       // «des-anulaba» una factura pasándola a issued o paid.
                       && (resource.data.get('status', '') != 'void' || isAdmin())
                       && (
                            (isPaymentOnlyUpdate() && (canWrite() || isAccountant())
                             && isPaymentStatusChange())
                            || (!isPaymentOnlyUpdate() && canWrite()
                                && canUseEmissionPoint(companyId)
                                && (request.resource.data.status != 'void' || isAdmin()))
                          );
        // El acumulado de retenciones recibidas (2026-10-08): su propia regla.
        allow update: if resource.data.status != 'cancelled'
                       && invoiceReceivedRetentionUpdateOk(companyId, id);
        allow delete: if false; // NEVER delete invoices
      }

      match /quotes/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow create, update: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /orders/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow create, update: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /electronic-documents/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow create: if isAuthenticated() && belongsToCompany(companyId) && canWrite();
        allow update, delete: if false; // Cloud Functions only
      }

      // XML original de los comprobantes importados (importInvoices). Lo escribe
      // solo el servidor; lo leen los de la empresa.
      // Configuración de la empresa. Hoy solo hay `settings/accounting` (qué
      // cuenta usa cada asiento automático). Caía en la regla general: la podían
      // reescribir un vendedor o un cajero, y el contador —que es quien la
      // mantiene— no podía guardarla (hallazgo del 2026-09-30).
      match /settings/{docId} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId)
                     && (isAdmin() || (docId == 'accounting' && isAccountant()));
      }

      match /imported-xml/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if false; // Cloud Functions only
      }

      // `smtp` queda fuera a propósito, y la exclusión va aquí porque las
      // reglas se suman: una regla estricta aparte no cerraría nada.
      match /configuration/{doc} {
        allow read: if isAuthenticated() && belongsToCompany(companyId)
                    && doc != 'smtp';
        allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin()
                    && doc != 'smtp';
      }

      // El correo con el que salen los comprobantes de esta empresa. Lo lee
      // solo su administrador y lo escribe **solo el servidor**
      // (`saveCompanySmtp`): así la contraseña acaba en Secret Manager y no
      // en la base de datos, como pasa con la del certificado.
      match /configuration/smtp {
        allow read: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        allow write: if false;
      }

      match /warehouses/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      // ─── Establecimientos ────────────────────────────────────────────────
      // /companies/{companyId}/establishments/{code}  — el id ES el código SRI
      // de 3 dígitos, así que es único por empresa. No se borran: hay
      // comprobantes emitidos con ese código; se desactivan (isActive: false).
      match /establishments/{code} {
        // El super admin y el admin del canal de la empresa también los
        // administran, desde la ficha de la empresa (inCallerChannel incluye al
        // super admin).
        function companyChannel() {
          return get(/databases/$(database)/documents/companies/$(companyId)).data.get('channelId', '');
        }
        allow read: if isAuthenticated()
                    && (belongsToCompany(companyId) || inCallerChannel(companyChannel()));
        allow create, update: if isAuthenticated()
                              && ((belongsToCompany(companyId) && isAdmin())
                                  || inCallerChannel(companyChannel()))
                              && code.matches('^[0-9]{3}$') && code != '000'
                              && request.resource.data.code == code;
        allow delete: if false;
      }

      match /counters/{id} {
        // Written atomically via runTransaction from Angular services
        // (invoices, retentions, purchases sequential numbering).
        allow read:  if isAuthenticated() && belongsToCompany(companyId);
        // El contador numera sus compras y sus asientos manuales, nada más.
        // Sin 'journal_entries' (hasta 2026-10-05) el contador no podía crear
        // un asiento: la numeración en transacción le daba permiso denegado.
        allow write: if isAuthenticated() && belongsToCompany(companyId)
                     && (canWrite() || (isAccountant() && id in ['purchases', 'journal_entries', 'retentions', 'debitNotes']));
      }

      match /stock-movements/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow create: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        allow update, delete: if false; // immutable audit trail
      }

      // ─── Retentions ──────────────────────────────────────────────────────
      // /companies/{companyId}/retentions/{docId}
      //
      // Retenciones are fiscal documents issued by the company to its
      // suppliers.  They are electronically sent to SRI after creation.
      match /retentions/{docId} {
        // READ — any authenticated member of the company with a fiscal role.
        allow read: if canReadFiscalDoc(companyId);

        // CREATE — en borrador o ya emitida («Emitir» del formulario crea con
        // status 'issued'; onRetentionEmit reacciona igual). Si trae companyId,
        // tiene que ser el del path: el formulario no lo manda, y exigirlo dejaba
        // sin poder crear retenciones a nadie en cuanto la regla por defecto
        // dejó de cubrirlas (auditoría del 2026-09-22).
        allow create: if canCreateFiscalDoc(companyId)
          && request.resource.data.status in ['draft', 'issued']
          && request.resource.data.get('companyId', companyId) == companyId
          && retentionSriClientCreate()
          && canUseEmissionPoint(companyId);

        // UPDATE — three independent guards must ALL pass:
        //   1. Caller must have fiscal-doc access to this company.
        //   2. A document already authorized by SRI can only have UI fields
        //      changed (the SRI-set fields are immutable from the client).
        //   3. status cannot be rolled back to 'draft' once past that stage.
        allow update: if canCreateFiscalDoc(companyId)
          && sriAuthorizedGuard()
          && retentionSriClientUpdate()
          && statusNotRolledBack()
          && canUseEmissionPoint(companyId)
          // Ejercicio cerrado: no se anula (2026-10-08).
          && notVoidingInClosedPeriod(companyId);

        // DELETE — only borradores (draft); only admin or accountant.
        // Issued or void retentions are legal records and must not be deleted.
        allow delete: if isAuthenticated()
          && belongsToCompany(companyId)
          && (isAdmin() || isAccountant())
          && resource.data.status == 'draft';
      }

      // ─── Debit Notes ──────────────────────────────────────────────────────
      // /companies/{companyId}/debitNotes/{docId}
      //
      // Same security model as retentions.  Minimum role to create: seller
      // (identical to invoices, since a debit note corrects or supplements
      // an invoice and follows the same commercial workflow).
      match /debitNotes/{docId} {
        // READ — same audience as retentions.
        allow read: if canReadFiscalDoc(companyId);

        // CREATE — en borrador o ya emitida; companyId, si viene, el del path.
        // Como las retenciones (2026-10-06): el cliente no la crea con estado
        // del SRI ni con los datos de la autorización (antes podía crearla
        // «autorizada» sin pasar por el SRI).
        allow create: if canCreateFiscalDoc(companyId)
          && request.resource.data.status in ['draft', 'issued']
          && request.resource.data.get('companyId', companyId) == companyId
          && retentionSriClientCreate()
          && canUseEmissionPoint(companyId);

        // UPDATE — same guards as retentions; sriStatus solo se puede borrar
        // (el «Reintentar» de una nota rechazada).
        allow update: if canCreateFiscalDoc(companyId)
          && sriAuthorizedGuard()
          && retentionSriClientUpdate()
          && statusNotRolledBack()
          && canUseEmissionPoint(companyId)
          // Ejercicio cerrado: no se anula (2026-10-08).
          && notVoidingInClosedPeriod(companyId);

        // DELETE — only borradores; only admin or accountant.
        allow delete: if isAuthenticated()
          && belongsToCompany(companyId)
          && (isAdmin() || isAccountant())
          && resource.data.status == 'draft';
      }

      // ─── Retenciones recibidas de clientes (2026-10-08) ─────────────────────
      // Ver receivedRetentionShapeOk y compañía, arriba.
      match /receivedRetentions/{rid} {
        allow read: if canReadFiscalDoc(companyId);

        allow create: if canRegisterReceivedRetention(companyId)
          && receivedRetentionShapeOk()
          // Su ejercicio no puede estar cerrado: el asiento no se haría nunca.
          && !periodClosed(companyId, 'y' + request.resource.data.fiscalYear)
          && receivedRetentionInvoiceCreateOk(companyId, rid, request.resource.data.invoiceId);

        allow update: if isAuthenticated() && belongsToCompany(companyId)
          && (isAdmin() || isAccountant())
          // Ejercicio cerrado: no se anula (como el resto de documentos).
          && notVoidingInClosedPeriod(companyId)
          && (receivedRetentionVoidOk(companyId, rid)
              || (resource.data.status == 'registered'
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['notes', 'updatedAt', 'updatedBy'])));

        // Un registro contable no se borra: se anula.
        allow delete: if false;
      }

      // ─── Purchases ────────────────────────────────────────────────────────────
      match /purchases/{purchaseId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId);
        allow create: if isAuthenticated() && belongsToCompany(companyId)
                      && canWritePurchases() && purchaseCreateOk();
        // Contenido: solo en borrador o enviada (purchaseContentUpdateOk).
        // Pago o anticipo: solo recibida, y el estado solo a 'paid'.
        // Sustento: admin o contador, recibida o pagada y sin retención.
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                      && canWritePurchases()
                      // Ejercicio cerrado: no se cancela (2026-10-08).
                      && notVoidingInClosedPeriod(companyId)
                      && (purchasePaymentUpdateOk() || purchaseContentUpdateOk()
                          || purchaseRetentionLinkOk(companyId)
                          || purchaseSustentoFixOk());
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin()
                      && resource.data.status == 'draft';
      }

      // ─── Team Management ──────────────────────────────────────────────────────

      match /tm-projects/{id} {
        allow read:          if isAuthenticated() && belongsToCompany(companyId);
        // El vendedor crea y edita proyectos: así lo dan las rutas y ROLE_MATRIX.
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                              && request.auth.token.role in ['admin', 'seller'];
        allow delete:         if isAuthenticated() && belongsToCompany(companyId) && isAdmin()
                              && resource.data.status == 'planning';
      }

      match /tm-tasks/{id} {
        allow read:          if isAuthenticated() && belongsToCompany(companyId);
        allow create, update: if isAuthenticated() && belongsToCompany(companyId);
        allow delete:         if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /tm-requests/{id} {
        allow read:          if isAuthenticated() && belongsToCompany(companyId);
        allow create, update: if isAuthenticated() && belongsToCompany(companyId);
        allow delete:         if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /tm-timesheets/{id} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId);
        allow create: if isAuthenticated() && belongsToCompany(companyId);
        allow update: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        allow delete: if false;  // audit trail inmutable
      }

      match /tm-members/{id} {
        allow read:  if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId)
                     && request.auth.token.role in ['admin', 'seller'];
      }

      // ─── Company Users ────────────────────────────────────────────────────
      // Perfil de plataforma de cada usuario dentro del tenant.
      // Doc ID = Firebase Auth UID (puente entre Firebase Auth y Firestore).
      //
      // CRIT-02 (DECISIÓN-02): platformRole y companyId solo pueden ser
      // escritos por Cloud Functions (Admin SDK, que bypasea estas reglas).
      // Desde el cliente — incluso admin — no se permiten cambios en esos campos.
      // La función isImmutableUserKeys() bloquea cualquier intento de modificarlos.
      match /company-users/{uid} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId);
        // Admin puede gestionar todos; cada usuario puede actualizar su propio perfil.
        allow create: if isAuthenticated() && belongsToCompany(companyId) && (isSuperAdmin() || isAdmin());
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                      && (isSuperAdmin() || isAdmin() || request.auth.uid == uid)
                      && !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['platformRole', 'companyId'])
                      // Los puntos de emisión los asigna el admin: si no, un
                      // cajero vaciaba su lista y quedaba con todos.
                      && (isSuperAdmin() || isAdmin()
                          || !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny(['emissionPoints', 'defaultEmissionPoint']));
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && (isSuperAdmin() || isAdmin());
      }

      match /tm-specialties/{id} {
        allow read:  if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /tm-positions/{id} {
        allow read:  if isAuthenticated() && belongsToCompany(companyId);
        allow write: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      // ─── Accounting ───────────────────────────────────────────────────────
      // Read: admin and accountant only (sellers/cashiers have no accounting access).
      // Write: admin or accountant, with extra guards per collection.

      match /chart_of_accounts/{accountId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant());
        // Admin o contador (decisión del usuario, 2026-09-30): armar y ajustar el
        // plan de cuentas es trabajo del contador. Antes, solo el admin.
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                              && (isAdmin() || isAccountant());
        // Accounts are never deleted — only inactivated via update.
        allow delete: if false;
      }

      match /accounting_periods/{periodId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant());
        // Abrir, cerrar o bloquear un ejercicio: admin o contador (2026-09-30).
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                              && (isAdmin() || isAccountant());
        // Periods are never deleted (audit trail).
        allow delete: if false;
      }

      match /cost_centers/{centerId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant());
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                              && (isAdmin() || isAccountant());
        // Only admin can delete cost centers.
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /journal_entries/{entryId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant());

        // CREATE — admin or accountant; new entries must start as 'draft'.
        allow create: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && request.resource.data.status == 'draft';

        // UPDATE — admin or accountant;
        //   • Automatic entries (type == 'automatic') cannot be edited by clients;
        //     only Cloud Functions (Admin SDK) may touch them.
        //   • Posted entries can only be cancelled (status forward-only guard).
        //   • Cancelled entries are immutable.
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && resource.data.get('type', 'manual') != 'automatic'
                      && resource.data.status != 'cancelled'
                      // Un borrador se edita y sigue borrador; lo contabilizado
                      // no vuelve a borrador. Antes exigía status != 'draft'
                      // siempre, y un borrador no se podía editar (2026-10-05).
                      && (resource.data.status == 'draft'
                          || request.resource.data.status != 'draft')
                      // Contabilizado: solo se anula, sin tocar líneas,
                      // montos ni fecha (2026-10-07). El borrador, como antes.
                      && (resource.data.status != 'posted' || postedEntryCancelOk())
                      // Conciliado con el banco: no se anula (2026-10-07).
                      && (request.resource.data.get('status', '') != 'cancelled'
                          || entryNotBankReconciled(companyId, entryId))
                      // Contabilizado en un ejercicio cerrado: no se anula
                      // (2026-10-08). Se corrige con un asiento en el abierto.
                      && (resource.data.status != 'posted'
                          || request.resource.data.get('status', '') != 'cancelled'
                          || !periodClosed(companyId, resource.data.get('periodId', '')));

        // DELETE — only draft manual entries; admin only.
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin()
                      && resource.data.status == 'draft'
                      && resource.data.get('type', 'manual') == 'manual';
      }

      // ─── Audit Log (Fase 7) ─────────────────────────────────────────────────
      // Log append-only escrito únicamente por Cloud Functions (Admin SDK,
      // audit-log-trigger.ts) — el cliente nunca escribe aquí, solo lee.
      match /audit_log/{logId} {
        allow read:  if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        allow write: if false;
      }

      // ─── Bank Accounts ────────────────────────────────────────────────────
      match /bank_accounts/{accountId} {
        allow read:            if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow create, update:  if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow delete:          if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      // ─── Formas de pago de la empresa (2026-10-05) ────────────────────────
      // Nombre propio («Transferencia Pichincha», «DeUna») + código de la
      // Tabla 24 del SRI, que es lo que va al XML, + la cuenta (bank_accounts)
      // donde entra o sale el dinero. Las lee todo usuario de la empresa: el
      // cajero las elige al facturar y al cobrar sin poder leer bank_accounts.
      // Las escriben el admin y el contador; borrar, solo el admin.
      match /paymentMethods/{methodId} {
        allow read:           if isAuthenticated() && belongsToCompany(companyId);
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                              && (isAdmin() || isAccountant())
                              && paymentMethodShapeOk();
        allow delete:         if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      // ─── Bank Statements + Transactions (subcollection) ───────────────────
      // Conciliación bancaria (2026-10-07, contrato con Conecta). Id del
      // extracto: `{bankAccountId}_{AAAA-MM}`. Conciliado = cerrado.
      match /bank_statements/{statementId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant());
        allow create: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && bankStatementShapeOk()
                      && request.resource.data.get('status', 'draft') in ['draft', 'in_progress'];
        // Abierto: admin o contador, sin cambiar de cuenta. Conciliado: solo
        // reabrirlo, y solo el admin.
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && bankStatementShapeOk()
                      && request.resource.data.bankAccountId == resource.data.get('bankAccountId', request.resource.data.bankAccountId)
                      && (resource.data.get('status', 'draft') != 'reconciled'
                          || bankStatementReopenOk());
        allow delete: if isAuthenticated() && belongsToCompany(companyId) && isAdmin()
                      && resource.data.get('status', 'draft') != 'reconciled';

        // Movimientos del extracto (id = hash del movimiento).
        match /transactions/{txId} {
          allow read:          if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
          allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant())
                               && bankStatementOpen(companyId, statementId);
          // Antes `if false`, y el «Eliminar extracto» de la web fallaba.
          // Un movimiento emparejado no se borra: primero se desempareja.
          allow delete:        if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant())
                               && bankStatementOpen(companyId, statementId)
                               && resource.data.get('status', 'unmatched') != 'matched';
        }

        // Emparejamientos movimiento(s) ↔ línea(s) de asiento. No se editan:
        // se borran y se vuelven a crear.
        match /matches/{matchId} {
          allow read:           if isAuthenticated() && belongsToCompany(companyId)
                                && (isAdmin() || isAccountant());
          allow create, delete: if isAuthenticated() && belongsToCompany(companyId)
                                && (isAdmin() || isAccountant())
                                && bankStatementOpen(companyId, statementId);
          allow update:         if false;
        }
      }

      // Asientos con líneas conciliadas (id = id del asiento). Mientras exista,
      // el asiento no se anula (ver journal_entries).
      match /bank_reconciled_entries/{entryId} {
        allow read:   if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant());
        allow create: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && request.resource.data.statementId is string
                      && request.resource.data.statementId.size() > 0;
        allow update: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && request.resource.data.statementId is string
                      && request.resource.data.statementId.size() > 0
                      && bankStatementGoneOrOpen(companyId, resource.data.get('statementId', ''));
        allow delete: if isAuthenticated() && belongsToCompany(companyId)
                      && (isAdmin() || isAccountant())
                      && bankStatementGoneOrOpen(companyId, resource.data.get('statementId', ''));
      }

      // ─── Advances (anticipos de clientes/proveedores) ──────────────────────
      match /advances/{advanceId} {
        allow read:            if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow create, update:  if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow delete:          if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      // ─── Petty Cash (caja chica) ────────────────────────────────────────────
      match /petty_cash_funds/{fundId} {
        allow read:            if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow create, update:  if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow delete:          if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      match /petty_cash_movements/{movementId} {
        allow read:            if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow create, update:  if isAuthenticated() && belongsToCompany(companyId)
                               && (isAdmin() || isAccountant());
        allow delete:          if false; // auditoría de gasto — no se borra, solo se marca reimbursed
      }

      // ─── Budgets ──────────────────────────────────────────────────────────
      match /budgets/{periodId} {
        allow read:          if isAuthenticated() && belongsToCompany(companyId)
                             && (isAdmin() || isAccountant());
        allow create, update: if isAuthenticated() && belongsToCompany(companyId)
                             && (isAdmin() || isAccountant());
        allow delete:         if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
      }

      // ─── Fixed Assets ─────────────────────────────────────────────────────
      match /fixed_assets/{assetId} {
        allow read:          if isAuthenticated() && belongsToCompany(companyId)
                             && (isAdmin() || isAccountant());
        allow create, update: if isAuthenticated() && belongsToCompany(companyId) && isAdmin();
        // Assets are never deleted — only deactivated via update.
        allow delete:         if false;
      }

      // ─── Monthly usage counters ───────────────────────────────────────────
      // Written exclusively by Cloud Functions via Admin SDK.
      // Company admin and users can read their own usage for the dashboard/subscription page.
      match /usage/{period} {
        allow read: if isAuthenticated() && belongsToCompany(companyId);
        allow write: if false;
      }

      // Default rule for all other sub-collections
      // Excludes the accounting collections above: they have their own
      // stricter admin/accountant-only rules and this rule's broader
      // canWrite() (seller/cashier included) must not re-grant that access.
      match /{collection}/{id} {
        allow read: if isAuthenticated() && belongsToCompany(companyId)
                    && !isAccountingGovernedCollection(collection)
                    && !hasOwnRules(collection);
        allow write: if isAuthenticated() && belongsToCompany(companyId) && canWrite()
                    && !isAccountingGovernedCollection(collection)
                    && !hasOwnRules(collection);
      }
    }

    // ── Public Catalogs — lectura anónima, escritura solo via Cloud Functions ──
    match /public-catalogs/{slug} {
      allow read: if true;
      allow write: if false;

      match /products/{productId} {
        allow read: if true;
        allow write: if false;
      }

      // Contadores de likes por producto — escritura pública anónima.
      // Validación: count debe ser número >= 0; solo se permiten los campos esperados.
      match /product-likes/{productId} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
                     && request.resource.data.count is int
                     && request.resource.data.count >= 0;
      }

      // Órdenes del catálogo — creación y lectura pública (sin auth).
      // Cualquier visitante puede crear una orden y consultar la suya por ID.
      // Actualización y eliminación denegadas desde el cliente;
      // solo el Admin SDK (Cloud Functions) y el admin autenticado del tenant pueden hacerlo.
      match /orders/{orderId} {
        // Cualquiera puede crear una orden (comprador anónimo).
        allow create: if request.resource.data.keys().hasAll([
                          'slug', 'companyId', 'customer', 'items',
                          'total', 'paymentMethod', 'paymentStatus',
                          'status', 'orderNumber', 'createdAt', 'updatedAt'
                        ])
                        && request.resource.data.total is number
                        && request.resource.data.total > 0
                        && request.resource.data.paymentStatus == 'pending'
                        && request.resource.data.status == 'new';

        // Lectura pública: el comprador accede por URL directa con el ID.
        allow read: if true;

        // Comprador: subir comprobante de pago (campos y estado estrictamente limitados).
        allow update: if request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['paymentProofUrl', 'paymentProofStoragePath',
                                     'paymentStatus', 'updatedAt'])
                       && request.resource.data.paymentStatus == 'proof_uploaded';

        // Admin del tenant: confirmar/rechazar pago y cambiar estado del pedido.
        // Verifica que el usuario autenticado pertenece a la empresa dueña del catálogo
        // leyendo el companyId del documento padre /public-catalogs/{slug}.
        allow update: if isAuthenticated()
                       && request.auth.token.role in ['admin', 'seller']
                       && get(/databases/$(database)/documents/public-catalogs/$(slug))
                            .data.companyId == request.auth.token.companyId;

        // Eliminación denegada desde el cliente (audit trail).
        allow delete: if false;
      }
    }

    // ─── Global users registry ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId);
      allow write: if isSuperAdmin();
    }

    // ─── Subscription plans ───────────────────────────────────────────────
    // Catálogo propio por canal: cada canal define sus planes y precios.
    // Los usuarios de empresa siguen leyendo el catálogo como antes (necesitan
    // su plan y la landing muestra los públicos); el acotado es el channel_admin,
    // que no debe ver ni tocar el catálogo de otro producto.
    match /plans/{planId} {
      allow read: if isAuthenticated()
                  && (!isChannelAdmin()
                      || inCallerChannel(resource.data.get('channelId', '')));

      allow create: if isAuthenticated()
                    && (isSuperAdmin()
                        || canCreateInCallerChannel());

      allow update, delete: if isAuthenticated()
                    && (isSuperAdmin()
                        || (inCallerChannel(resource.data.get('channelId', ''))
                            && channelUnchanged()));
    }

    // ─── Canales ──────────────────────────────────────────────────────────
    // Los crea SOLO el super admin de plataforma (scripts/seed-channel.ts).
    // Un channel_admin puede leer el suyo, para mostrar nombre y estado.
    match /channels/{channelId} {
      allow read: if isAuthenticated()
                  && (isSuperAdmin() || (isChannelAdmin() && channelId == callerChannel()));
      allow write: if isSuperAdmin();
    }

    // ─── Platform modules catalog ─────────────────────────────────────────
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── Platform actions catalog ─────────────────────────────────────────
    match /actions/{actionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── Platform permissions catalog ────────────────────────────────────
    match /permissions/{permId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── Plugin packages catalog ──────────────────────────────────────────
    // Commercial bundles of modules — read by any authenticated user
    // (TenantService and company settings view need it), write only super_admin.
    match /plugin-packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── Roles catalog ────────────────────────────────────────────────────
    // System and custom roles — read by any authenticated user (needed for
    // user management UI and role selectors), write only admin or super_admin.
    //
    // MED-03 (DECISIÓN-02): admin solo puede crear/editar roles de type:'custom'.
    // Los roles de type:'system' son inmutables desde el cliente; solo
    // super_admin puede modificarlos. Además, no se permite cambiar el type
    // de un rol existente (ej: custom → system) desde el cliente.
    match /roles/{roleId} {
      allow read: if isAuthenticated();

      // super_admin puede crear cualquier tipo de rol.
      // admin solo puede crear roles de tipo 'custom'.
      allow create: if isAuthenticated()
        && (isSuperAdmin()
            || (isAdmin() && request.resource.data.type == 'custom'));

      // super_admin puede actualizar cualquier rol.
      // admin puede actualizar solo roles 'custom' y no puede cambiar el type.
      allow update: if isAuthenticated()
        && (isSuperAdmin()
            || (isAdmin()
                && resource.data.type == 'custom'
                && request.resource.data.type == 'custom'));

      allow delete: if isSuperAdmin();
    }

    // ─── Platform defaults ────────────────────────────────────────────────
    // /platform/defaults              ← config general (country, vatRate)
    // /platform/defaults/sriConfig/data
    // /platform/defaults/smtpConfig/data
    // /platform/defaults/taxRates/{id}
    // /platform/defaults/paymentTerms/{id}
    // /platform/defaults/documentSeries/{id}
    // /platform/defaults/warehouses/{id}
    // /platform/defaults/currencies/{id}
    // /platform/defaults/countries/{id}
    match /platform/defaults {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ⚠️ La contraseña del correo saliente vive en smtpConfig, en claro. Con la
    // regla general —leer todo lo de defaults con solo estar autenticado—
    // cualquier usuario de cualquier empresa podía leerla: un cajero, o un
    // miembro de un grupo de Conecta conectado por identidad federada. Es el
    // mismo fallo que tenía la contraseña del certificado. Las reglas **se
    // suman**, así que no basta con añadir una regla estricta abajo: hay que
    // excluir smtpConfig de la general.
    match /platform/defaults/{subCollection}/{docId} {
      allow read: if isAuthenticated() && subCollection != 'smtpConfig';
      allow write: if isSuperAdmin() && subCollection != 'smtpConfig';
    }

    // Desde el 2026-09-30 la contraseña ya no está aquí (Secret Manager) y el
    // documento lo escribe solo savePlatformSmtp: ni el super admin lo escribe
    // desde el navegador, para que nadie vuelva a guardar la contraseña en claro.
    match /platform/defaults/smtpConfig/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ─── Multi-empresa — empresas vinculadas a una cuenta ─────────────────────
    // /account-companies/{uid}/companies/{companyId}
    // Cada usuario puede leer solo sus propias empresas vinculadas.
    // Escritura exclusiva por Cloud Functions via Admin SDK (super_admin via CF).
    match /account-companies/{uid}/companies/{companyId} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
