rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // SRI certificates — Cloud Functions access only, never from browser
    match /companies/{companyId}/certificates/{file} {
      allow read, write: if false;
    }

    // Company logos — readable by company members, writable by admin or super_admin
    match /companies/{companyId}/logos/{file} {
      allow read: if request.auth != null
                  && (request.auth.token.companyId == companyId
                      || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null
                   && (request.auth.token.companyId == companyId
                       || request.auth.token.role == 'super_admin')
                   && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Product images — path: companies/{companyId}/products/{productId}/main.{ext}
    match /companies/{companyId}/products/{allPaths=**} {
      allow read: if request.auth != null
                  && (request.auth.token.companyId == companyId
                      || request.auth.token.role == 'super_admin');
      allow write: if request.auth != null
                   && (request.auth.token.companyId == companyId
                       || request.auth.token.role == 'super_admin')
                   && request.auth.token.role in ['admin', 'seller', 'super_admin']
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Electronic documents (XML, RIDE PDFs) — readable by company members
    match /companies/{companyId}/electronic-documents/{file} {
      allow read: if request.auth != null && request.auth.token.companyId == companyId;
      allow write: if false; // Cloud Functions only
    }

    // Comprobantes de pago del marketplace — escritura y lectura públicas (sin auth).
    // El comprador sube el comprobante sin estar autenticado.
    // Restricciones: solo imágenes o PDF, máximo 5 MB.
    match /catalog-orders/{slug}/{orderId}/{file} {
      allow read: if true;
      allow write: if request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
