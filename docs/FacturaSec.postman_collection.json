{
  "info": {
    "name": "FacturaSec — Cloud Functions",
    "description": "Colección completa para validar todas las Cloud Functions de facturación electrónica SRI Ecuador.\n\n**Setup:**\n1. Configura las variables de entorno en el Environment adjunto.\n2. Ejecuta primero '0. Auth > Get ID Token' para obtener el token.\n3. Sigue el orden numérico de las carpetas para cada flujo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://us-central1-facturasproec.cloudfunctions.net", "type": "string" },
    { "key": "firebaseApiKey", "value": "AIza...", "description": "Web API Key del proyecto Firebase (Firebase Console > Project Settings)", "type": "string" },
    { "key": "idToken", "value": "", "description": "Se llena automáticamente al ejecutar 'Get ID Token'", "type": "string" },
    { "key": "companyId", "value": "COMPANY_ID_AQUI", "type": "string" },
    { "key": "invoiceId", "value": "", "type": "string" },
    { "key": "creditNoteId", "value": "", "type": "string" },
    { "key": "debitNoteId", "value": "", "type": "string" },
    { "key": "retentionId", "value": "", "type": "string" },
    { "key": "testEmail", "value": "tucorreo@email.com", "type": "string" },
    { "key": "testRuc", "value": "1713175071001", "description": "RUC de empresa de prueba", "type": "string" },
    { "key": "certBase64", "value": "", "description": "Certificado .p12 en Base64", "type": "string" },
    { "key": "certPassword", "value": "", "description": "Contraseña del certificado .p12", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "description": "Autenticación Firebase. Ejecutar primero para obtener idToken.",
      "item": [
        {
          "name": "Get ID Token (email + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.idToken) {",
                  "  pm.collectionVariables.set('idToken', res.idToken);",
                  "  pm.test('Token obtenido OK', () => pm.response.to.have.status(200));",
                  "  console.log('Token expira en:', res.expiresIn, 'segundos');",
                  "} else {",
                  "  pm.test('ERROR: no se obtuvo token', () => false);",
                  "  console.log(JSON.stringify(res));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tuempresa.com\",\n  \"password\": \"tu_password\",\n  \"returnSecureToken\": true\n}"
            }
          }
        }
      ]
    },
