    {
      "name": "7. Seguridad — Casos de Error",
      "description": "Verificar que las funciones rechazan accesos no autorizados correctamente.",
      "item": [
        {
          "name": "Sin token → unauthenticated",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Debe retornar 401', () => pm.response.to.have.status(401));",
                  "const res = pm.response.json();",
                  "pm.test('Error unauthenticated', () => pm.expect(res.error.status).to.equal('UNAUTHENTICATED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/generateInvoiceXml",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"invoiceId\": \"{{invoiceId}}\",\n    \"companyId\": \"{{companyId}}\"\n  }\n}"
            }
          }
        },
        {
          "name": "companyId diferente → permission-denied",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Debe retornar 403', () => pm.response.to.have.status(403));",
                  "const res = pm.response.json();",
                  "pm.test('Error permission-denied', () => pm.expect(res.error.status).to.equal('PERMISSION_DENIED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "url": "{{baseUrl}}/generateInvoiceXml",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"invoiceId\": \"{{invoiceId}}\",\n    \"companyId\": \"OTRO_COMPANY_ID_QUE_NO_ES_EL_TUYO\"\n  }\n}"
            }
          }
