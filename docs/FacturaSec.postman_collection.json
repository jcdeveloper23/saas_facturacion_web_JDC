                  "pm.test('accessKey tiene 49 dígitos', () => pm.expect(res.result.accessKey.length).to.equal(49));",
                  "pm.test('codDoc es 07 (Retención)', () => pm.expect(res.result.accessKey.substring(8,10)).to.equal('07'));",
                  "console.log('accessKey Retención:', res.result.accessKey);"
                ]
              }
            }
