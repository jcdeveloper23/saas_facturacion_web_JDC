    {
      "name": "2. Factura Electrónica",
      "description": "Flujo completo: XML → Firma → SRI → PDF → Email",
      "item": [
        {
          "name": "2.1 generateInvoiceXml",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene accessKey', () => pm.expect(res.result.accessKey).to.be.a('string'));",
                  "pm.test('accessKey tiene 49 dígitos', () => pm.expect(res.result.accessKey.length).to.equal(49));",
                  "pm.test('Tiene xmlUrl', () => pm.expect(res.result.xmlUrl).to.be.a('string'));",
                  "",
                  "// Validar módulo 11 del dígito verificador",
                  "const key = res.result.accessKey;",
                  "const digits = key.split('').map(Number);",
                  "const weights = [2,3,4,5,6,7];",
                  "let sum = 0;",
                  "for (let i = 0; i < 48; i++) {",
                  "  sum += digits[i] * weights[i % 6];",
                  "}",
                  "const remainder = sum % 11;",
                  "const verifier = remainder === 0 ? 0 : remainder === 1 ? 1 : 11 - remainder;",
                  "pm.test('Dígito verificador módulo 11 correcto', () => pm.expect(digits[48]).to.equal(verifier));",
                  "",
                  "console.log('accessKey:', key);",
                  "console.log('xmlUrl:', res.result.xmlUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "url": "{{baseUrl}}/generateInvoiceXml",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"invoiceId\": \"{{invoiceId}}\",\n    \"companyId\": \"{{companyId}}\"\n  }\n}"
            }
          }
        },
        {
          "name": "2.2 signXml (factura)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene signedXmlUrl', () => pm.expect(res.result.signedXmlUrl).to.be.a('string'));",
                  "console.log('signedXmlUrl:', res.result.signedXmlUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "url": "{{baseUrl}}/signXml",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"invoiceId\": \"{{invoiceId}}\",\n    \"companyId\": \"{{companyId}}\"\n  }\n}"
            }
          }
        },
        {
          "name": "2.3 sendToSri (factura)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene sriStatus', () => pm.expect(res.result.sriStatus).to.be.a('string'));",
                  "",
                  "const status = res.result.sriStatus;",
                  "console.log('sriStatus:', status);",
                  "",
                  "if (status === 'authorized') {",
                  "  pm.test('AUTORIZADO: tiene authorizationNumber', () => pm.expect(res.result.authorizationNumber).to.be.a('string'));",
                  "  pm.test('AUTORIZADO: tiene authorizedAt', () => pm.expect(res.result.authorizedAt).to.exist);",
                  "  pm.test('authorizationNumber tiene 49 dígitos', () => pm.expect(res.result.authorizationNumber.length).to.equal(49));",
                  "  console.log('Número autorización:', res.result.authorizationNumber);",
                  "} else if (status === 'rejected') {",
                  "  console.log('RECHAZADO - Error SRI:', res.result.sriError);",
                  "  pm.test('RECHAZADO: tiene sriError', () => pm.expect(res.result.sriError).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "url": "{{baseUrl}}/sendToSri",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"invoiceId\": \"{{invoiceId}}\",\n    \"companyId\": \"{{companyId}}\",\n    \"documentType\": \"invoice\"\n  }\n}"
            }
          }
        },
