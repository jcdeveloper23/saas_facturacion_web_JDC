{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.0",
    "bwip-js": "^4.11.4",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "jszip": "^3.10.1",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.2.3",
    "@types/jest": "^29.5.14",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.0",
    "@types/pdfkit": "^0.13.0",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "commonjs",
          "strict": true,
          "target": "es2020",
          "skipLibCheck": true,
          "noUnusedLocals": false
        }
      }
    }
  },
  "private": true
}
